# Shared local environment placeholders.
# Real secrets belong in GitHub Actions secrets, Vercel environment variables,
# New Relic, SonarCloud/SonarQube, or Snyk settings. Do not commit real values.

# Deployment Environment
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics & Monitoring
NEW_RELIC_LICENSE_KEY=
NEXT_PUBLIC_NEW_RELIC_APP_ID=

# Quality & Security
SONAR_TOKEN=
SNYK_TOKEN=

# Secrets (Vercel / GitHub)
VERCEL_TOKEN=

# Personal mobile in E.164 form, e.g. +66000000000. Deliberately NOT NEXT_PUBLIC_*:
# that prefix would inline it into the browser bundle, which is what this variable
# exists to avoid. Unset is fine - the vCard omits its TEL line and /card/whatsapp
# returns 404. Set it in Vercel for production only.
CONTACT_PHONE_E164=
