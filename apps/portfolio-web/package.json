{
  "name": "portfolio-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "generate:brand": "bun run scripts/generate-brand-assets.ts",
    "generate:qr": "bun run scripts/generate-qr.ts",
    "vendor:post-images": "bun run scripts/vendor-post-images.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@patorsiang/content": "workspace:*",
    "@patorsiang/cv-engine": "workspace:*",
    "@patorsiang/ui": "workspace:*",
    "@patorsiang/utils": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@patorsiang/configs": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/nextjs-vite": "^10.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "qrcode": "^1.5.4",
    "storybook": "^10.4.2",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
